{
  "name": "findmykz",
  "version": "1.0.0",
  "private": true,
  "description": "Find CS2 KZ maps by their properties. Static, frontend-only property database.",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/pack-data.mjs",
    "package": "npm run build && node scripts/package-site.mjs",
    "watch": "tsc --watch",
    "pack": "node scripts/pack-data.mjs",
    "serve": "python3 -m http.server 5173 --directory public",
    "dev": "npm run build && npm run serve",
    "refresh:data": "node scripts/refresh-cs2kz-data.mjs",
    "top-times": "node scripts/update-top-times.mjs",
    "steam:data": "node scripts/fetch-steam-maps.mjs",
    "apply:changes": "node scripts/apply-changes.mjs",
    "seed": "node scripts/refresh-cs2kz-data.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
